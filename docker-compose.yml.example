# Preflight uses this service's environment and volumes:
# docker compose -f docker-compose.yml.example run --rm --no-deps emby-watchparty python -m backend.migration_preflight --root /app --target production --deployment docker
# Generated from deploy/schema.json; do not edit.
# Schema-Version: 1
# Schema-SHA256: 04aa16e1188e664518f105a7a34036f0f290cf2ac13707de1318df5a33096c73
services:
  emby-watchparty:
    image: ghcr.io/oratorian/emby-watchparty:3.0
    container_name: emby-watchparty
    environment:
      WATCH_PARTY_BIND: 0.0.0.0
      WATCH_PARTY_PORT: '5000'
      APP_PREFIX: ${APP_PREFIX:-}
      SESSION_EXPIRY: ${SESSION_EXPIRY:-86400}
      EMBY_SERVER_URL: ${EMBY_SERVER_URL:-http://emby:8096}
      EMBY_API_KEY: ${EMBY_API_KEY:-}
      APP_ENV: ${APP_ENV:-production}
      SESSION_SECRET: ${SESSION_SECRET:-}
      SESSION_COOKIE_SECURE: ${SESSION_COOKIE_SECURE:-true}
      CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS:-}
      TRUSTED_PROXY_CIDRS: ${TRUSTED_PROXY_CIDRS:-}
      ENABLE_HLS_TOKEN_VALIDATION: ${ENABLE_HLS_TOKEN_VALIDATION:-true}
      BEHIND_PROXY: ${BEHIND_PROXY:-}
    ports:
    - 5000:5000
    volumes:
    - ./data:/app/data
    - ./images/avatars:/app/images/avatars
    - ./logs:/app/logs
    - ./config.json:/app/config.json
    restart: unless-stopped
