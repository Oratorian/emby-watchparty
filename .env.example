# Generated from deploy/schema.json; do not edit.
# Schema-Version: 1
# Schema-SHA256: 3d72f870f57b7dde8f468e08dbc1823e8e5e14ebe730af5ff84332064df098ed
# Production starts fail-closed until every required blank is configured.

# Address listened on inside the container. Supplied container artifacts pin this to 0.0.0.0.
WATCH_PARTY_BIND=0.0.0.0

# Port listened on inside the container. Supplied container artifacts pin this to 5000; change only the published host port.
WATCH_PARTY_PORT=5000

# Optional slash-prefixed reverse-proxy subpath.
# Leave unset unless the app is served under a subpath. Setting this to a
# path you are not actually proxying makes every URL 404.
APP_PREFIX=

# Signed session-cookie lifetime in seconds.
# Now genuinely governs the session cookie lifetime. The default 86400 asks
# people to rejoin after 24h idle; set 1209600 to keep 2.x's 14 days.
SESSION_EXPIRY=86400

# HTTP(S) URL reachable from the container to Emby.
EMBY_SERVER_URL=http://emby:8096

# Dedicated Emby administrative API key.
EMBY_API_KEY=

# Security validation mode; appliances use production.
APP_ENV=production

# Stable signing secret generated once and retained across updates.
# Generate ONCE with `openssl rand -hex 32` and keep it. An ephemeral key is
# used when empty, which kicks every user out on every restart.
SESSION_SECRET=

# Restrict session cookies to HTTPS.
# Set true when the app is reached over HTTPS, false for a plain-HTTP LAN
# address. A Secure cookie is silently discarded by the browser over http://,
# which logs everyone out on the next request rather than failing loudly.
# Production also requires true, so a plain-HTTP deployment needs a TLS
# terminator in front.
# SESSION_COOKIE_SECURE=

# Comma-separated public HTTP(S) origins allowed by Socket.IO.
# Comma-separated origin allowlist for Socket.IO. Production rejects '*'.
CORS_ALLOWED_ORIGINS=

# Comma-separated proxy source networks trusted for forwarded client IPs.
# Mandatory when BEHIND_PROXY=true; this is what restores per-viewer limits.
# Comma separated. 172.16.0.0/12 covers the default Docker bridge networks,
# which is where a proxy container connects from; use 127.0.0.1/32 for a
# proxy running on the host.
TRUSTED_PROXY_CIDRS=

# Validate signed HLS playlist and segment tokens.
# Boot setting; changes need a restart and it is not in the admin panel.
# Production requires it enabled. If you turned it off in 2.x Admin ->
# Security, that value carries over and you must set true here.
ENABLE_HLS_TOKEN_VALIDATION=true

# Declare whether a reverse proxy terminates client connections.
# Required in production, and deliberately has no default: rate limiting keys
# on the connecting address, so behind a proxy that is the proxy for every
# viewer and they all share one bucket. Guessing wrong is silent, so 3.0
# refuses to boot rather than guess. Set true or false explicitly.
# BEHIND_PROXY=
