# Generated from deploy/schema.json; do not edit.
# Schema-Version: 1
# Schema-SHA256: 04aa16e1188e664518f105a7a34036f0f290cf2ac13707de1318df5a33096c73
# Production starts fail-closed until every required blank is configured.

# Address listened on inside the container. Supplied container artifacts pin this to 0.0.0.0.
WATCH_PARTY_BIND=0.0.0.0

# Port listened on inside the container. Supplied container artifacts pin this to 5000; change only the published host port.
WATCH_PARTY_PORT=5000

# Optional slash-prefixed reverse-proxy subpath.
APP_PREFIX=

# Signed session-cookie lifetime in seconds.
SESSION_EXPIRY=86400

# HTTP(S) URL reachable from the container to Emby.
EMBY_SERVER_URL=http://emby:8096

# Dedicated Emby administrative API key.
EMBY_API_KEY=

# Security validation mode; appliances use production.
APP_ENV=production

# Stable signing secret generated once and retained across updates.
SESSION_SECRET=

# Restrict session cookies to HTTPS.
SESSION_COOKIE_SECURE=true

# Comma-separated public HTTP(S) origins allowed by Socket.IO.
CORS_ALLOWED_ORIGINS=

# Comma-separated proxy source networks trusted for forwarded client IPs.
TRUSTED_PROXY_CIDRS=

# Validate signed HLS playlist and segment tokens.
ENABLE_HLS_TOKEN_VALIDATION=true

# Declare whether a reverse proxy terminates client connections.
BEHIND_PROXY=
