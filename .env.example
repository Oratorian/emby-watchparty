# Emby Watch Party Configuration
#
# Only the boot-essential values live here. All mutable runtime
# settings (logging, security, rate limits, late-join vote, static
# session, REQUIRE_LOGIN, FORCE_TRANSCODE, etc.) are managed via the
# Admin Panel at /admin and persisted to config.json. A restart is
# only required for changes to the values below.
#
# Upgrading from 2.1.x? Back up this file, Compose/container configuration,
# config.json, data/, images/avatars/, and volume mappings. Then run the
# read-only preflight documented in docs/Migration-HowTo.md before starting 3.0.

# ============== Application ==============
# Network bind. 0.0.0.0 listens on all interfaces (typical for Docker).
WATCH_PARTY_BIND=0.0.0.0
WATCH_PARTY_PORT=5000

# `production` enables startup validation for secure cookie/CORS/session/HLS
# settings. Keep `development` for local plain-HTTP use.
APP_ENV=development

# Session cookie lifetime in seconds (default: 24h). Use 1209600 to retain the
# old 2.1.x 14-day cookie behavior.
SESSION_EXPIRY=86400

# Base URL prefix for reverse-proxy deployments behind a subpath.
# Example: APP_PREFIX=/watchparty serves the entire app under
# https://example.com/watchparty/ -- backend routers, Socket.IO,
# /assets, and the SPA all honour the prefix at runtime, so the same
# image works for any subpath (or for root) without a rebuild.
# Leave empty (default) for root-of-domain deployments.
#APP_PREFIX=/watchparty

# ============== Session Cookie (new in 2.0.0-beta18) ==============
# The signing key for the party-bound session cookie. Must persist
# across process restarts or existing cookies stop verifying -- generate
# ONCE with `openssl rand -hex 32`
# (or `python -c "import secrets; print(secrets.token_hex(32))"`) and
# leave it. If unset, an ephemeral random key is generated at boot
# with a loud warning: fine for local dev, catastrophic in production
# (every restart kicks everyone out of their party). Multi-worker mode is
# unsupported because all party/security registries are process-local.
SESSION_SECRET=change-me-openssl-rand-hex-32

# When `true`, the session cookie carries the Secure flag so browsers
# only send it over HTTPS. Set `true` in every deployment behind TLS;
# leave `false` for local http://localhost dev (cookies stripped from
# insecure origins if this is `true`, which locks you out).
SESSION_COOKIE_SECURE=false

# ============== Socket.IO CORS (new in 2.0.0-beta18) ==============
# Comma-separated origin allowlist for the Socket.IO server. `*`
# (default, historical behaviour) accepts XHR-poll handshakes from any
# origin -- convenient for testing, but pair with per-IP throttling
# in production. Pin to your real origin(s) for a proper deployment,
# e.g. `https://watchparty.example.com,https://staging.example.com`.
CORS_ALLOWED_ORIGINS=*

# Does a reverse proxy (nginx, Caddy, Traefik, Cloudflare Tunnel, ...)
# terminate client connections? Required in production; there is no safe
# default, so the server refuses to boot rather than guess.
#
# Rate limiting keys on the address the connection arrives from. Behind a
# proxy that address is the proxy for every viewer, so all of them share
# one bucket: 5 party creations per hour and 30 socket connects per
# minute, deployment-wide, and the person affected just sees it not work.
# Setting this to true makes TRUSTED_PROXY_CIDRS mandatory, which is what
# restores per-viewer limits.
#
# Set false when this server is reachable directly. That is not a
# downgrade: with no proxy in front, ignoring forwarded headers is the
# correct and safer behaviour.
BEHIND_PROXY=false

# Comma-separated proxy CIDRs allowed to supply Forwarded/X-Forwarded-For.
# Empty means forwarded client IP headers are ignored, which is correct
# when BEHIND_PROXY=false and a boot error when it is true.
#
# Use the network your proxy connects from, not the client's. For the
# default Docker bridge that is usually 172.16.0.0/12; for a proxy on the
# same host, 127.0.0.1/32.
TRUSTED_PROXY_CIDRS=

# Boot security control. Production mode requires this to stay true.
# Changes require restart and are not available in the runtime admin panel.
ENABLE_HLS_TOKEN_VALIDATION=true

# ============== Emby Server ==============
# Only the admin API key is required here. Per-user authentication is
# an in-app action: any party member clicks "Login to Become Host"
# inside the party and supplies their own Emby credentials. The
# backend never stores long-lived user credentials at rest -- only
# this admin server key.
EMBY_SERVER_URL=http://localhost:8096
EMBY_API_KEY=your-api-key-here
