# Emby Watch Party Configuration
# Copy this file to .env and update with your settings
# All other settings are managed via the Admin Panel (/admin)

# ============== Application ==============
WATCH_PARTY_BIND=0.0.0.0
WATCH_PARTY_PORT=5000
SESSION_EXPIRY=86400

# REQUIRE_LOGIN gates party CREATION:
#   false (default): anyone can create a party. Any member can later
#                    log in with Emby credentials to become host and
#                    unlock the library.
#   true           : creating a party requires Emby credentials in the
#                    request. The creator becomes host atomically.
# Browsing the library is always gated on the party having a host with
# a valid Emby session, regardless of this setting.
REQUIRE_LOGIN=false

# Base URL prefix for reverse proxy deployments
# Example: APP_PREFIX=/watchparty for https://example.com/watchparty/
# Leave empty for root deployment (default)
#APP_PREFIX=/watchparty

# ============== Emby Server ==============
# Only an API key (admin server key) is required. Per-user authentication
# happens at runtime via the in-app "Login to Become Host" flow; no
# long-lived user credentials are stored.
EMBY_SERVER_URL=http://localhost:8096
EMBY_API_KEY=your-api-key-here
