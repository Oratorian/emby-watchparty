<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <!-- Schema-SHA256: 6da4b3538b883f26e2e26b1337045b2b28a8d05c01033454cf64d58b7e881d4c -->
  <Name>Emby-Watch-Party</Name>
  <Repository>ghcr.io/oratorian/emby-watchparty:3.0</Repository>
  <Registry>https://github.com/Oratorian/emby-watchparty/pkgs/container/emby-watchparty</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Oratorian/emby-watchparty/issues</Support>
  <Project>https://github.com/Oratorian/emby-watchparty</Project>
  <Overview>Production-safe Emby Watch Party 3.0 appliance deployment.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:5000]/</WebUI>
  <Icon>https://raw.githubusercontent.com/Oratorian/emby-watchparty/3.0-dev/frontend/public/favicon.ico</Icon>
  <ExtraParams />
  <PostArgs />
  <Config Name="Web Port" Target="5000" Default="5000" Mode="tcp" Description="Host port for Emby Watch Party." Type="Port" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="Data" Target="/app/data" Default="/mnt/user/appdata/emby-watchparty/data" Mode="rw" Description="Persistent data directory." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/emby-watchparty/data</Config>
  <Config Name="Avatars" Target="/app/images/avatars" Default="/mnt/user/appdata/emby-watchparty/images/avatars" Mode="rw" Description="Persistent avatars directory." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/emby-watchparty/images/avatars</Config>
  <Config Name="Logs" Target="/app/logs" Default="/mnt/user/appdata/emby-watchparty/logs" Mode="rw" Description="Persistent logs directory." Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/emby-watchparty/logs</Config>
  <Config Name="Config" Target="/app/config.json" Default="/mnt/user/appdata/emby-watchparty/config.json" Mode="rw" Description="Persistent config file." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/emby-watchparty/config.json</Config>
  <Config Name="Bind Address" Target="WATCH_PARTY_BIND" Default="0.0.0.0" Mode="" Description="Address listened on inside the container." Type="Variable" Display="advanced" Required="true" Mask="false">0.0.0.0</Config>
  <Config Name="Container Port" Target="WATCH_PARTY_PORT" Default="5000" Mode="" Description="Port listened on inside the container." Type="Variable" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="URL Prefix" Target="APP_PREFIX" Default="" Mode="" Description="Optional slash-prefixed reverse-proxy subpath." Type="Variable" Display="advanced" Required="false" Mask="false" />
  <Config Name="Session Lifetime" Target="SESSION_EXPIRY" Default="86400" Mode="" Description="Signed session-cookie lifetime in seconds." Type="Variable" Display="advanced" Required="true" Mask="false">86400</Config>
  <Config Name="Emby Server URL" Target="EMBY_SERVER_URL" Default="http://emby:8096" Mode="" Description="HTTP(S) URL reachable from the container to Emby." Type="Variable" Display="always" Required="true" Mask="false">http://emby:8096</Config>
  <Config Name="Emby API Key" Target="EMBY_API_KEY" Default="" Mode="" Description="Dedicated Emby administrative API key." Type="Variable" Display="always" Required="true" Mask="true" />
  <Config Name="Application Environment" Target="APP_ENV" Default="production|development" Mode="" Description="Security validation mode; appliances use production." Type="Variable" Display="always" Required="true" Mask="false">production</Config>
  <Config Name="Session Secret" Target="SESSION_SECRET" Default="" Mode="" Description="Stable signing secret generated once and retained across updates." Type="Variable" Display="always" Required="true" Mask="true" />
  <Config Name="Secure Session Cookie" Target="SESSION_COOKIE_SECURE" Default="true|false" Mode="" Description="Restrict session cookies to HTTPS." Type="Variable" Display="always" Required="true" Mask="false">true</Config>
  <Config Name="Allowed Origins" Target="CORS_ALLOWED_ORIGINS" Default="" Mode="" Description="Comma-separated public HTTP(S) origins allowed by Socket.IO." Type="Variable" Display="always" Required="true" Mask="false" />
  <Config Name="Trusted Proxy CIDRs" Target="TRUSTED_PROXY_CIDRS" Default="" Mode="" Description="Comma-separated proxy source networks trusted for forwarded client IPs." Type="Variable" Display="always" Required="true" Mask="false" />
  <Config Name="HLS Token Validation" Target="ENABLE_HLS_TOKEN_VALIDATION" Default="true|false" Mode="" Description="Validate signed HLS playlist and segment tokens." Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="Behind Reverse Proxy" Target="BEHIND_PROXY" Default="|true|false" Mode="" Description="Declare whether a reverse proxy terminates client connections." Type="Variable" Display="always" Required="true" Mask="false" />
</Container>
